<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              LE LIEN yoppaa:// (02/10). Le bouton « Revenir dans Yoppaa » de
              la page /retour-app, quand la banque a fini dans Chrome. L hote
              est fige : MainActivity n ouvre que www.yoppaa.app.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="yoppaa" android:host="www.yoppaa.app" />
            </intent-filter>

            <!--
              LES LIENS D APP (02/10). Un lien www.yoppaa.app touche dans un
              email ouvre l app au lieu de Chrome : connexion, commande, bon
              cadeau. SEULES les pages Yopper : le tableau de bord commercant
              reste une PWA dans le navigateur.
              ⚠️ autoVerify : Android verifie le fichier
              /.well-known/assetlinks.json du site. Tant qu il manque, les
              liens s ouvrent dans le navigateur, comme avant.
              ⚠️ La meme liste que l apple-app-site-association.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.yoppaa.app" />
                <data android:pathPrefix="/commander" />
                <data android:pathPrefix="/carte/" />
                <data android:pathPrefix="/cadeau/" />
                <data android:pathPrefix="/empreinte/" />
                <data android:pathPrefix="/retour-app/" />
            </intent-filter>

        </activity>

        <!--
          ⚠️ ONESIGNAL N OUVRE PLUS D ADRESSE TOUT SEUL (02/10). Le toucher est
          traite par l app (PontNatif, lib/push-natif.js), qui ouvre la page
          DANS sa vue. Sans cette ligne, une notification portant une adresse
          l ouvrirait dans le navigateur.
        -->
        <meta-data android:name="com.onesignal.suppressLaunchURLs" android:value="true" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      🔴 LA POSITION, ET CE MANQUE A FAILLI PARTIR EN PRODUCTION (17/09 minuit).
      Le manifeste ne declarait QUE l acces reseau. Or `navigator.geolocation`
      est appele dans quatre fichiers, et un WebView Android ne peut PAS
      accorder ce que le manifeste ne demande pas : la position aurait ete
      refusee a l ouverture, en silence, et l ecran principal se serait vide.

      ⚠️ AUCUN PLUGIN NE L AJOUTE A NOTRE PLACE. Depuis le 02/10, la position
      passe par `@capacitor/geolocation`, et son manifeste ne declare AUCUNE
      permission (verifie dans le paquet installe). Rien ne fusionne donc dans
      ce fichier, contrairement a ce qu on lit partout.

      ⚠️ ET C EST APPLE QUI L A TROUVE, pas nous. Le mail ITMS-90683 parlait de
      l `Info.plist` ; le defaut vivait aussi ici, sans que rien ne le dise.

      ⚠️ LES DEUX NIVEAUX, ET C EST VOULU. `COARSE` seule donne 1 a 3 km : assez
      pour deviner la commune, pas pour ecrire « a 400 m de toi ». Un chiffre
      faux est pire qu un chiffre absent. `FINE` au premier plan ne demande
      aucun formulaire supplementaire chez Google ; c est `BACKGROUND_LOCATION`
      qui en exige un, et nous ne la demandons pas.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
      ⚠️ LE GPS N EST PAS OBLIGATOIRE POUR INSTALLER. Sans cette ligne, Google
      Play deduit de la permission ci-dessus que l appareil DOIT avoir un GPS,
      et masque l application a ceux qui n en ont pas. Yoppaa sait vivre sans :
      on choisit sa commune a la main.
    -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />
</manifest>
