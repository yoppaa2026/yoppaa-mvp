<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      🔴 LA POSITION, ET CE MANQUE A FAILLI PARTIR EN PRODUCTION (17/09 minuit).
      Le manifeste ne declarait QUE l acces reseau. Or `navigator.geolocation`
      est appele dans quatre fichiers, et un WebView Android ne peut PAS
      accorder ce que le manifeste ne demande pas : la position aurait ete
      refusee a l ouverture, en silence, et l ecran principal se serait vide.

      ⚠️ AUCUN PLUGIN NE L AJOUTE A NOTRE PLACE : on utilise l API du
      navigateur, pas `@capacitor/geolocation`. Rien ne fusionne donc de
      permission dans ce fichier, contrairement a ce qu on lit partout.

      ⚠️ ET C EST APPLE QUI L A TROUVE, pas nous. Le mail ITMS-90683 parlait de
      l `Info.plist` ; le defaut vivait aussi ici, sans que rien ne le dise.

      ⚠️ LES DEUX NIVEAUX, ET C EST VOULU. `COARSE` seule donne 1 a 3 km : assez
      pour deviner la commune, pas pour ecrire « a 400 m de toi ». Un chiffre
      faux est pire qu un chiffre absent. `FINE` au premier plan ne demande
      aucun formulaire supplementaire chez Google ; c est `BACKGROUND_LOCATION`
      qui en exige un, et nous ne la demandons pas.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
      ⚠️ LE GPS N EST PAS OBLIGATOIRE POUR INSTALLER. Sans cette ligne, Google
      Play deduit de la permission ci-dessus que l appareil DOIT avoir un GPS,
      et masque l application a ceux qui n en ont pas. Yoppaa sait vivre sans :
      on choisit sa commune a la main.
    -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />
</manifest>
